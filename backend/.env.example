# Server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STARVECTOR_ENABLED=true
STARVECTOR_MODEL=starvector/starvector-1b-im2svg
STARVECTOR_ATTN_IMPLEMENTATION=eager
STARVECTOR_MAX_LENGTH=4000
# Hugging Face token (faster downloads, higher rate limits)
HF_TOKEN=

# Cross-engine ensemble + residual refinement (runs on every conversion)
AUTO_USE_ENSEMBLE=true
REFINE_MAX_PASSES=20
REFINE_MIN_DELTA=0.0005
REFINE_RESIDUAL_THRESHOLD=12
REFINE_MIN_MASK_RATIO=0.0005

# Smooth-curve VTracer pipeline: palette-quantize input + smooth grid so logo
# letters don't get traced as choppy bumps along JPEG/AA noise.
VTRACER_SMOOTH_ENABLED=true
VTRACER_SMOOTH_PALETTE_SIZE=6
VTRACER_SMOOTH_BILATERAL=true

# Agent payments (optional): $0.50 per conversion
PAYMENTS_ENABLED=false
PRICE_PER_CONVERSION_USD=0.50
MPP_SECRET_KEY=
MPP_TEMPO_RECIPIENT=
MPP_TEMPO_CURRENCY=

X402_ENABLED=false
X402_EVM_ADDRESS=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532

# Post-conversion SVG editor (xAI Grok). Leave blank to disable the chat
# panel on /editor/:jobId; the UI shows a friendly notice instead of a 500.
XAI_API_KEY=
GROK_MODEL=grok-4-latest
EDITOR_FREE_LIMIT=0
EDITOR_MAX_SVG_BYTES=524288
