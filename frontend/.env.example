# Leave empty when using `npm run dev` (Vite proxies /api to the backend).
# VITE_API_BASE=http://127.0.0.1:8000

# Optional: change proxy target (default http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional: hide the SVG editor (Edit button + /editor/:jobId route). Default: enabled.
# VITE_EDITOR_ENABLED=false
